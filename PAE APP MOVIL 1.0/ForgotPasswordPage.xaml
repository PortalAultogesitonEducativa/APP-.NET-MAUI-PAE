<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PAE_APP_MOVIL_1._0.ForgotPasswordPage"
             BackgroundColor="#FDF3EA"
             Title="Recuperar contraseña">

    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="0" VerticalOptions="Center">

            <Border BackgroundColor="White" Stroke="Transparent" Padding="28,32">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Label Text="¿Olvidaste tu contraseña?"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#152A4E"
                           HorizontalOptions="Center" />

                    <Label Text="Ingresa tu usuario o correo y te enviaremos instrucciones."
                           FontSize="13"
                           TextColor="#8A8A8A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Usuario o Correo"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#152A4E" />

                    <Border BackgroundColor="#FAFAFA" Stroke="#DDDDDD" StrokeThickness="1" Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="UsuarioEntry"
                               Placeholder="correo@ejemplo.com"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#B0B0B0" />
                    </Border>

                    <Button x:Name="EnviarBtn"
                            Text="Enviar solicitud"
                            BackgroundColor="#152A4E"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="48"
                            Clicked="OnEnviarClicked" />

                    <ActivityIndicator x:Name="CargandoIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#152A4E" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>