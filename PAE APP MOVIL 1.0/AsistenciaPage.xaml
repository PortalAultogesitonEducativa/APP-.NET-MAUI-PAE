<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PAE_APP_MOVIL_1._0.AsistenciaPage"
             BackgroundColor="#F5F5F7"
             Title="Asistencia">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20,20">

        <Label x:Name="TituloLabel"
               Grid.Row="0"
               Text="Asistencia"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#152A4E"
               Margin="0,0,0,8" />

        <Border Grid.Row="1"
                BackgroundColor="#EAF7EF"
                Padding="16,12"
                Stroke="Transparent"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Label x:Name="FallasLabel"
                   Text="Cargando..."
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#1E8E5A" />
        </Border>

        <CollectionView x:Name="AsistenciaCollection" Grid.Row="2">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            Padding="16"
                            Margin="0,0,0,10"
                            Stroke="#EEEEEE"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#152A4E" />
                                <Label Text="{Binding justificacion}"
                                       FontSize="12"
                                       TextColor="#8A8A8A"
                                       IsVisible="{Binding justificacion, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding estado}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1E8E5A"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="SinRegistrosLabel"
               Grid.Row="2"
               Text="No hay registros de asistencia."
               FontSize="14"
               TextColor="#8A8A8A"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               IsVisible="False" />

        <ActivityIndicator x:Name="CargandoIndicator"
                           Grid.Row="3"
                           IsRunning="False"
                           IsVisible="False"
                           Color="#152A4E" />

    </Grid>

</ContentPage>