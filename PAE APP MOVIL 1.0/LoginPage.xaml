<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PAE_APP_MOVIL_1._0.LoginPage"
             BackgroundColor="#FDF3EA">

    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="0" VerticalOptions="Center">

            <Border BackgroundColor="White"
                    Stroke="Transparent"
                    Padding="28,32">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <Image Source="logo_pae.png"
                           HeightRequest="90"
                           WidthRequest="90"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />

                    <Label Text="Bienvenido a PAE"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#152A4E"
                           HorizontalOptions="Center" />

                    <Label Text="Portal de Autogestión Educativa"
                           FontSize="14"
                           TextColor="#8A8A8A"
                           HorizontalOptions="Center"
                           Margin="0,-12,0,10" />

                    <Label Text="Usuario o Correo"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#152A4E" />

                    <Border BackgroundColor="#FAFAFA"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="UsuarioEntry"
                               Placeholder="correo@ejemplo.com"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#B0B0B0" />
                    </Border>

                    <Label Text="Contraseña"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#152A4E" />

                    <Border BackgroundColor="#FAFAFA"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="0"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="#B0B0B0" />
                            <Button x:Name="TogglePasswordBtn"
                                    Grid.Column="1"
                                    Text="👁"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    TextColor="#152A4E"
                                    Padding="4,0"
                                    Clicked="OnToggleMostrarPassword" />
                        </Grid>
                    </Border>

                    <Label Text="¿Olvidó su contraseña?"
                           FontSize="13"
                           TextColor="#152A4E"
                           HorizontalOptions="End"
                           Margin="0,0,0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOlvidoPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Button x:Name="IngresarBtn"
                            Text="Ingresar al Sistema"
                            BackgroundColor="#152A4E"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="24"
                            HeightRequest="48"
                            Clicked="OnIngresarClicked" />

                    <ActivityIndicator x:Name="CargandoIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#152A4E" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>